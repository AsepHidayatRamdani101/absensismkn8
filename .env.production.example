
APP_NAME="Sistem Absensi SMKN 8 Garut"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=<https://alamat-aplikasi-sekolah>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensismkn8
DB_USERNAME=<user_db_aplikasi>
DB_PASSWORD=<password_db_yang_kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_DEFAULT_COUNTRY_CODE=62
FONNTE_TEST_BATCH_DELAY_MS=1200
FONNTE_REMINDER_ENABLED=false
FONNTE_REMINDER_TIME=14:00
FONNTE_SCHOOL_NAME="SMKN 8 GARUT"

VITE_APP_NAME="${APP_NAME}"

APP_FORCE_HTTPS=true
TRUSTED_PROXIES=
SANCTUM_EXPIRATION=43200
BACKUP_DB_KEEP_DAYS=14
BACKUP_FULL_KEEP_DAYS=56
SHARED_REPORT_KEEP_DAYS=7
SEED_ADMIN_EMAIL=admin@smkn8.sch.id
SEED_ADMIN_PASSWORD=
