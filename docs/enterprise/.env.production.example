APP_NAME="ABS SMKN8"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.sch.id

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensismkn8
DB_USERNAME=absensi_user
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
CACHE_PREFIX=absensismkn8-prod

QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailserver.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.sch.id
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.sch.id
MAIL_FROM_NAME="ABS SMKN8"

FONNTE_ENABLED=true
FONNTE_TOKEN=CHANGE_ME
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_DEFAULT_COUNTRY_CODE=62
FONNTE_TEST_BATCH_DELAY_MS=1200
FONNTE_REMINDER_ENABLED=true
FONNTE_REMINDER_TIME=14:00
FONNTE_SCHOOL_NAME="SMKN 8 GARUT"
